{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The PrismForge window: its own session and profile commands and the session and lifecycle view events. No plugin permission.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-view",
    "allow-connect-openrgb",
    "allow-start-demo",
    "allow-disconnect",
    "allow-refresh",
    "allow-identify",
    "allow-effect-catalog",
    "allow-apply-effect",
    "allow-stop-effect",
    "allow-select-mode",
    "allow-declare-external",
    "allow-clear-external",
    "allow-set-frame-rate",
    "allow-preview-effect",
    "allow-profile-store",
    "allow-profile-details",
    "allow-create-profile",
    "allow-preview-profile-update",
    "allow-update-profile",
    "allow-rename-profile",
    "allow-duplicate-profile",
    "allow-delete-profile",
    "allow-apply-profile",
    "allow-set-apply-on-connect",
    "allow-export-profile",
    "allow-import-profile",
    "allow-set-device-name",
    "allow-set-zone-name",
    "allow-dismiss-store-notice",
    "allow-lifecycle",
    "allow-change-setting",
    "allow-answer-close",
    "allow-quit"
  ]
}
